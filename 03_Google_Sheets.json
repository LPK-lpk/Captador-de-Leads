    {
      "parameters": {
        "jsCode": "// ============================================================\n// $input.all() contém:\n//   - linhas da planilha (items sem campo 'leads')\n//   - 1 item agregado com campo 'leads' (array de leads)\n// ============================================================\n\nconst MAX_POR_RODADA = 50;\n\nconst allItems = $input.all();\n\n// Separa: item com leads vs linhas da planilha\nconst leadsItem = allItems.find(item => Array.isArray(item.json.leads));\nconst sheetItems = allItems.filter(item => !Array.isArray(item.json.leads));\n\n// Números já na planilha\nconst existentes = new Set(\n  sheetItems\n    .map(i => (i.json.WhatsApp || i.json.whatsapp || '').toString().trim())\n    .filter(Boolean)\n);\n\nconst leadsData = leadsItem?.json.leads || [];\n\nif (leadsData.length === 0) {\n  return [{ json: { inseridos: 0, duplicados: 0, mensagem: 'Nenhum lead recebido' } }];\n}\n\nconst novos = [];\nlet duplicados = 0;\n\nfor (const lead of leadsData) {\n  const num = (lead.WhatsApp || '').toString().trim();\n  if (!num) continue;\n\n  if (existentes.has(num)) {\n    duplicados++;\n  } else {\n    existentes.add(num);\n    novos.push({ json: lead });\n  }\n}\n\nif (novos.length === 0) {\n  return [{ json: { inseridos: 0, duplicados, mensagem: 'Todos os leads já existem na planilha' } }];\n}\n\n// Limita a 50 por rodada (quota Google Sheets)\nconst lote = novos.slice(0, MAX_POR_RODADA);\nlote[0].json._duplicados = duplicados;\nlote[0].json._restantes = novos.length - lote.length;\nreturn lote;"
      },
