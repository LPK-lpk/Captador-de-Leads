{
  "name": "00 - Importador Leads Barbearia",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "importar-leads-barbearia",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000001",
      "name": "Webhook - Receber Chamada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "importar-leads-barbearia"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "init-001",
              "name": "instance",
              "value": "={{ $json.body?.instance || $json.instance || 'barbearia' }}",
              "type": "string"
            },
            {
              "id": "init-002",
              "name": "iniciadoEm",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000002",
      "name": "Set - Parâmetros",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $env.WF_01_BUSCAR_CHATS }}",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "instance": "={{ $json.instance }}"
          },
          "schema": [
            {
              "id": "instance",
              "displayName": "instance",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000003",
      "name": "SW01 - Buscar Chats",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $env.WF_02_PROCESSAR_LEADS }}",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "passthrough"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000004",
      "name": "SW02 - Processar Leads",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $env.WF_03_GOOGLE_SHEETS }}",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "passthrough"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000005",
      "name": "SW03 - Salvar Sheets",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// Workflow Principal | Consolidar Estatísticas\n// Conta inseridos vs duplicados e monta resposta final\n// ============================================================\n\nconst itens = $input.all();\n\nlet inseridos = 0;\nlet duplicados = 0;\nlet erros = 0;\n\nfor (const item of itens) {\n  const r = item.json.resultado || '';\n  if (r === 'inserido') inseridos++;\n  else if (r === 'duplicado') duplicados++;\n  else erros++;\n}\n\nconst total = inseridos + duplicados + erros;\n\nconst finalizadoEm = new Date().toLocaleString('pt-BR', {\n  timeZone: 'America/Sao_Paulo',\n  day: '2-digit',\n  month: '2-digit',\n  year: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit'\n});\n\nreturn [{\n  json: {\n    sucesso: true,\n    mensagem: `Importação concluída`,\n    estatisticas: {\n      total,\n      inseridos,\n      duplicados,\n      erros\n    },\n    finalizadoEm\n  }\n}];"
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000006",
      "name": "Code - Consolidar Estatísticas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000007",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "Webhook - Receber Chamada": {
      "main": [
