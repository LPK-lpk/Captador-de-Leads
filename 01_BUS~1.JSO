{
  "name": "01 - Buscar Chats Evolution",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "inst-001",
              "name": "instance",
              "value": "={{ $json.instance || 'barbearia' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Set - Instância",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// 01 - Buscar Chats Evolution | Paginação Completa\n// Busca TODOS os chats históricos em páginas de 100,\n// filtra grupos/canais e normaliza os dados.\n// ============================================================\n\nconst instance  = $json.instance;\nconst baseUrl   = $env.EVOLUTION_URL.replace(/\\/$/, '');\nconst apikey    = $env.EVOLUTION_APIKEY;\nconst LIMIT     = 100; // chats por página\n\n// ── Helpers ──────────────────────────────────────────────────\n\nfunction extrairMensagem(msg) {\n  if (!msg) return '';\n  const m = msg.message || {};\n  if (typeof m === 'string')                  return m;\n  if (m.conversation)                         return m.conversation;\n  if (m.extendedTextMessage?.text)            return m.extendedTextMessage.text;\n  if (m.imageMessage)                         return '[Imagem]';\n  if (m.audioMessage)                         return '[Áudio]';\n  if (m.videoMessage)                         return '[Vídeo]';\n  if (m.documentMessage)                      return '[Documento]';\n  if (m.stickerMessage)                       return '[Figurinha]';\n  if (m.locationMessage)                      return '[Localização]';\n  if (m.contactMessage)                       return '[Contato]';\n  return '[Mídia]';\n}\n\nfunction extrairTimestamp(chat, msg) {\n  const ts = msg?.messageTimestamp || msg?.timestamp || chat?.updatedAt || '';\n  if (!ts) return '';\n  const n = Number(ts);\n  if (!isNaN(n) && n > 0) return new Date(n * 1000).toISOString();\n  if (typeof ts === 'string') {\n    const d = new Date(ts);\n    if (!isNaN(d.getTime())) return d.toISOString();\n  }\n  return '';\n}\n\nfunction normalizar(chats) {\n  const resultado = [];\n  for (const chat of chats) {\n    const id = chat.id || chat.remoteJid || '';\n\n    // Filtros de exclusão\n    if (!id) continue;\n    if (id.includes('@g.us'))        continue; // grupos\n    if (id.includes('@newsletter'))  continue; // canais\n    if (id.includes('@broadcast'))   continue; // broadcasts\n    if (id === 'status@broadcast')   continue; // status\n    if (id.includes('lid'))          continue; // IDs internos Meta\n\n    const numero = id.split('@')[0].replace(/\\D/g, '');\n    if (!/^\\d{10,15}$/.test(numero)) continue;\n\n    const msg = chat.lastMessage || chat.messages?.[0] || null;\n\n    resultado.push({\n      json: {\n        numero,\n        nome:            chat.name || chat.pushName || numero,\n        pushName:        chat.pushName || '',\n        ultimaMensagem:  extrairMensagem(msg).substring(0, 500),\n        timestamp:       extrairTimestamp(chat, msg),\n        grupo:           false\n      }\n    });\n  }\n  return resultado;\n}\n\n// ── Loop de paginação ─────────────────────────────────────────\n\nconst url = `${baseUrl}/chat/findChats/${instance}`;\nlet offset    = 0;\nlet allChats  = [];\nlet pagina    = 1;\nlet hasMore   = true;\n\nwhile (hasMore) {\n  let data;\n\n  try {\n    // Tenta POST com body (Evolution API v2+)\n    const res = await fetch(url, {\n      method: 'POST',\n      headers: {\n        'apikey':       apikey,\n        'Content-Type': 'application/json'\n      },\n      body: JSON.stringify({ limit: LIMIT, offset })\n    });\n\n    data = await res.json();\n\n    // Fallback: se POST retornar erro, tenta GET com query params\n    if (data?.status >= 400 || data?.error) {\n      const resGet = await fetch(`${url}?limit=${LIMIT}&offset=${offset}`, {\n        method: 'GET',\n        headers: { 'apikey': apikey }\n      });\n      data = await resGet.json();\n    }\n  } catch (e) {\n    throw new Error(`Falha na requisição (página ${pagina}): ` + e.message);\n  }\n\n  // Detectar array de chats na resposta\n  let chats = [];\n  if (Array.isArray(data)) {\n    chats = data;\n  } else if (Array.isArray(data?.chats)) {\n    chats = data.chats;\n  } else {\n    // Procurar array em qualquer chave\n    for (const val of Object.values(data || {})) {\n      if (Array.isArray(val)) { chats = val; break; }\n    }\n  }\n\n  allChats = allChats.concat(chats);\n\n  // Se recebeu menos que o limite, chegamos ao fim\n  if (chats.length < LIMIT) {\n    hasMore = false;\n  } else {\n    offset += LIMIT;\n    pagina++;\n  }\n\n  // Segurança: máximo de 50 páginas (5.000 chats)\n  if (pagina > 50) hasMore = false;\n}\n\nif (allChats.length === 0) {\n  return [{ json: { chats: [], total: 0, mensagem: 'Nenhum chat encontrado na instância' } }];\n}\n\nconst resultado = normalizar(allChats);\n\nif (resultado.length === 0) {\n  return [{ json: { chats: [], total: 0, mensagem: 'Nenhum contato individual após filtragem' } }];\n}\n\nreturn resultado;"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Code - Buscar Todos os Chats (Paginado)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "out-001",
              "name": "numero",
              "value": "={{ $json.numero }}",
              "type": "string"
            },
            {
              "id": "out-002",
              "name": "nome",
              "value": "={{ $json.nome }}",
              "type": "string"
            },
            {
              "id": "out-003",
              "name": "pushName",
              "value": "={{ $json.pushName }}",
              "type": "string"
            },
            {
              "id": "out-004",
              "name": "ultimaMensagem",
              "value": "={{ $json.ultimaMensagem }}",
              "type": "string"
            },
            {
              "id": "out-005",
              "name": "timestamp",
              "value": "={{ $json.timestamp }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Return - Chats Normalizados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300]
    }
  ],
