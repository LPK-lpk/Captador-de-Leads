{
  "name": "01 - Buscar Chats Evolution",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "inst-001",
              "name": "instance",
              "value": "={{ $json.instance }}",
              "type": "string"
            },
            {
              "id": "inst-002",
              "name": "evolutionUrl",
              "value": "={{ $json.evolutionUrl || 'http://n8n-evolution.ndjgby.easypanel.host' }}",
              "type": "string"
            },
            {
              "id": "inst-003",
              "name": "apikey",
              "value": "={{ $json.apikey || 'SUA_APIKEY' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Set - Instância",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.evolutionUrl }}/chat/findChats/{{ $json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.apikey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"where\": {}, \"page\": {\"limit\": 1000, \"offset\": 0}}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "HTTP - Buscar Chats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 160],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Set - Instância').first().json.evolutionUrl }}/contacts/fetchContacts/{{ $('Set - Instância').first().json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Set - Instância').first().json.apikey }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "HTTP - Fetch Contatos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 440],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
      "name": "Merge - Unir Fontes",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// Normalizar contatos de duas fontes:\n// 1. findChats  — chats com histórico de mensagens\n// 2. fetchContacts — agenda completa de contatos\n// ============================================================\n\nconst itens = $input.all();\n\nif (!itens || itens.length === 0) {\n  return [{ json: { chats: [], total: 0, mensagem: 'Nenhum contato encontrado' } }];\n}\n\n// ── Helpers ──────────────────────────────────────────────────\n\nfunction extrairMensagem(msg) {\n  if (!msg) return '';\n  const m = msg.message || {};\n  if (typeof m === 'string')           return m;\n  if (m.conversation)                  return m.conversation;\n  if (m.extendedTextMessage?.text)     return m.extendedTextMessage.text;\n  if (m.imageMessage)                  return '[Imagem]';\n  if (m.audioMessage)                  return '[Áudio]';\n  if (m.videoMessage)                  return '[Vídeo]';\n  if (m.documentMessage)               return '[Documento]';\n  if (m.stickerMessage)                return '[Figurinha]';\n  if (m.locationMessage)               return '[Localização]';\n  if (m.contactMessage)                return '[Contato]';\n  return '[Mídia]';\n}\n\nfunction extrairTimestamp(chat, msg) {\n  const ts = msg?.messageTimestamp || msg?.timestamp\n    || chat?.updatedAt || chat?.lastMessage?.messageTimestamp || '';\n  if (!ts) return '';\n  const n = Number(ts);\n  if (!isNaN(n) && n > 0) return new Date(n * 1000).toISOString();\n  if (typeof ts === 'string') {\n    const d = new Date(ts);\n    if (!isNaN(d.getTime())) return d.toISOString();\n  }\n  return '';\n}\n\n// ── Processar e deduplicar ────────────────────────────────────\n\nconst resultado = [];\nconst vistos = new Set();\n\nfor (const item of itens) {\n  const chat = item.json;\n\n  // Pular itens de erro\n  if (chat.error || chat.status === 404 || chat.code === 'ERR_BAD_REQUEST') continue;\n\n  const id = chat.id\n    || chat.remoteJid\n    || chat.jid\n    || chat.lastMessage?.key?.remoteJid\n    || chat.lastMessage?.remoteJid\n    || chat.key?.remoteJid\n    || '';\n\n  if (!id) continue;\n  if (id.includes('@g.us'))       continue;\n  if (id.includes('@newsletter')) continue;\n  if (id.includes('@broadcast'))  continue;\n  if (id === 'status@broadcast')  continue;\n  if (id.includes(':'))           continue; // dispositivos secundários\n  if (id.toLowerCase().includes('lid')) continue;\n\n  const numero = id.split('@')[0].replace(/\\D/g, '');\n  if (!/^\\d{8,15}$/.test(numero)) continue;\n\n  // Deduplicar entre as duas fontes\n  if (vistos.has(numero)) continue;\n  vistos.add(numero);\n\n  const msg = chat.lastMessage || null;\n  const isFromMe = msg?.key?.fromMe === true;\n\n  // Evitar \"Você\" — só usa pushName da lastMessage se não for fromMe\n  const pushNameContato = chat.pushName\n    || (!isFromMe ? (msg?.pushName || '') : '')\n    || '';\n\n  resultado.push({\n    json: {\n      numero,\n      nome:           chat.name || pushNameContato || numero,\n      pushName:       pushNameContato,\n      ultimaMensagem: extrairMensagem(msg).substring(0, 500),\n      timestamp:      extrairTimestamp(chat, msg),\n      grupo:          false\n    }\n  });\n}\n\nif (resultado.length === 0) {\n  return [{ json: { chats: [], total: 0, mensagem: 'Nenhum contato individual após filtragem' } }];\n}\n\nreturn resultado;"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Code - Normalizar Chats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "out-001",
              "name": "numero",
              "value": "={{ $json.numero }}",
              "type": "string"
            },
            {
              "id": "out-002",
              "name": "nome",
              "value": "={{ $json.nome }}",
              "type": "string"
            },
            {
              "id": "out-003",
              "name": "pushName",
              "value": "={{ $json.pushName }}",
              "type": "string"
            },
            {
              "id": "out-004",
              "name": "ultimaMensagem",
              "value": "={{ $json.ultimaMensagem }}",
              "type": "string"
            },
            {
              "id": "out-005",
              "name": "timestamp",
              "value": "={{ $json.timestamp }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Return - Chats Normalizados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          { "node": "Set - Instância", "type": "main", "index": 0 }
        ]
      ]
    },
    "Set - Instância": {
      "main": [
        [
          { "node": "HTTP - Buscar Chats", "type": "main", "index": 0 },
          { "node": "HTTP - Fetch Contatos", "type": "main", "index": 0 }
        ]
      ]
    },
    "HTTP - Buscar Chats": {
      "main": [
        [
          { "node": "Merge - Unir Fontes", "type": "main", "index": 0 }
        ]
      ]
    },
    "HTTP - Fetch Contatos": {
      "main": [
        [
          { "node": "Merge - Unir Fontes", "type": "main", "index": 1 }
        ]
      ]
    },
    "Merge - Unir Fontes": {
      "main": [
        [
          { "node": "Code - Normalizar Chats", "type": "main", "index": 0 }
        ]
      ]
    },
    "Code - Normalizar Chats": {
      "main": [
        [
          { "node": "Return - Chats Normalizados", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "barbearia-leads-importer"
  }
}
